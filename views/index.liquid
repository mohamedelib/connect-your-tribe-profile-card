{% render 'partials/head.liquid' %}

<article class="card-wrapper" tabindex="0">

  <div class="card-inner">

    <section class="card front">
      <h1>مُحَمَّد</h1>
    </section>

    <section class="card back">
      <h2>مُحَمَّد</h2>
      <h3>{{person.name}}</h3>
      <p class="role"> {{custom.Role}}</p>
      <p class="squad">Squad: {{custom.Squad}}</p>

      <ul>
        <li><a href="https://github.com/{{ person.github_handle }}">Github : {{ person.github_handle }}</a></li>
        <li><a href="{{ custom.email }}">mohamed.el.ibrahymy@hva.nl</a></li>
        <li> {{ person.bio }}</li>
        <li>{{custom.Location}}</li>
      </ul> 

      <img class="profile" src="{{ person.avatar }}" alt="Foto van Mohamed" >
    </section>
    
  </div>
</article>
<button class="visually-hidden">Sluiten</button>
{% render 'partials/foot.liquid' %}
