{% render 'partials/head.liquid' %}

<article class="card-wrapper">

  <div class="card-inner">

    <section class="card front">
      <h1>مُحَمَّد</h1>
    </section>

    <section class="card back">
      <h2>مُحَمَّد</h2>
      <h3>{{person.name}}</h3>
      <p class="role"> {{custom.Role}}</p>
      <p class="squad">Squad: {{custom.Squad}}</p>

      <ul>
        <li><a href="https://github.com/{{ person.github_handle }}">Github : {{ person.github_handle }}</a></li>
        <li><a href="mohamed.el.ibrahymy@hva.nl">mohamed.el.ibrahymy@hva.nl</a></li>
        <li> {{ person.bio }}</li>
        <li>{{custom.Location}}</li>
      </ul> 

      <img class="profile" src="https://fv5-3.files.fm/thumb_show.php?i=x83qgjxsjf&view&v=1&PHPSESSID=1cc18362ba7a86f9a1a0707013d48b7cbcd63204" alt="Foto van Mohamed" >
    </section>

  </div>
</article>

{% render 'partials/foot.liquid' %}
